# ─────────────────────────────────────────────
# Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────

# Required: Random 32+ character string for sealing session cookies
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Required for deployment (also set as GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Selects a [env.<name>] block from wrangler.toml — at BUILD time, not deploy time.
# `nuxt build` generates .output/server/wrangler.json, and NuxtHub flattens the named
# environment into it and removes every other one. That is why the deploy command stays a
# plain `wrangler versions upload` with no --env flag: by then there are no environments
# left in the file. Set it as a Workers Builds build variable on the non-production branch
# trigger, or use `bun run build:preview` / `bun run deploy:preview` locally.
# Leave unset for production builds.
# CLOUDFLARE_ENV=preview

# Which queue the email consumer owns. Set in wrangler.toml [vars] (and again,
# with a different value, in [env.preview.vars]) — you should not normally need
# it here, because the queue consumer only runs in a deployed Worker. Unset
# means "accept every batch", which is the safe default for a Worker with one
# consumer: a name that does not match makes the consumer skip the batch, and
# skipping without acking acks it by omission.
# NUXT_EMAIL_QUEUE_NAME=

# Optional: Enables Claude Code's GitHub MCP server (repo read scope is sufficient)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: PostHog product analytics + session replay + exception tracking.
# Get the phc_… project key from: https://us.posthog.com/settings/project
# Set in nuxt.config.ts default OR override here in dev. Empty = disabled.
# NUXT_PUBLIC_POSTHOG_KEY=
# NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Password and passkeys only (layers/credentials). Sign-up and password reset
# mail a link, so they need the Resend keys further down. Locally, leave Resend
# unset: there is a dev-only email sign-in (server/api/auth/dev.post.ts) that
# never ships to production.

# ── Public origin ────────────────────────────────────────────────────────────
# No trailing slash. Emails, sitemap.xml and og: tags build absolute links from
# this. Locally, match your portless host (https://my-app.localhost).
# NUXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bot check (Cloudflare Turnstile) ─────────────────────────────────────────
# Guards the public, unauthenticated forms — anonymous feedback today, the
# magic-link request next. Both keys come from one place: dash.cloudflare.com →
# Turnstile → Add site (free, and it works on localhost if you add it as a
# hostname).
#
# Leave BOTH empty to develop locally: no widget renders and the server skips
# verification, so the feedback form works as it always did. Setting only the
# site key is the one bad state — the widget appears and nothing checks it —
# and the server logs `turnstile_half_configured` when it detects that.
#
# For testing the wired-up flow without a real site, Cloudflare publishes
# always-passing dummy keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# NUXT_TURNSTILE_SECRET_KEY=

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Empty key = every send is a logged no-op, so OAuth sign-in and webhooks still
# work. Magic-link sign-in is the exception, because there the email IS the
# flow: in dev the link is logged to the server console instead, and in
# production the request returns 503 rather than claiming to have sent one. Set
# these before you ship if email sign-in is your front door.
#
# Human-set secrets — get the key from resend.com/api-keys, and `from` must be
# on a domain verified at resend.com/domains.
# NUXT_RESEND_API_KEY=
# NUXT_RESEND_FROM=My App <hello@example.com>

# ── Fleet (portfolio dashboard) ──────────────────────────────────────────────
# Bearer the `fleet` dashboard presents to GET /api/fleet for this app's
# counters. Leave unset and the route 404s — the app is simply not on the
# dashboard. 32+ characters: openssl rand -base64 32. In production this is a
# Worker secret (`wrangler secret put NUXT_FLEET_TOKEN`); _PREVIOUS is only set
# while rotating, see server/utils/fleet-auth.ts.
# NUXT_FLEET_TOKEN=
# NUXT_FLEET_TOKEN_PREVIOUS=
