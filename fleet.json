{
  "schema": 1,
  "slug": "dearmantel",
  "name": "Dear Mantel",
  "stage": "unreleased",
  "urls": { "prod": "https://dearmantel.jeremy-ettlinger.workers.dev" },
  "workers": ["dearmantel"],
  "bindings": {
    "d1": [{ "name": "dearmantel-db", "id": "2849245e-64da-46a3-b2cd-659db234d10f" }],
    "kv": ["d3c08c2747884a2b8d0b85697c02c41a"],
    "r2": ["dearmantel-blob"]
  },
  "crons": ["0 4 * * *", "*/15 * * * *"],
  "deploy": "workers-builds",
  "template": { "repo": "Holojerm/nuxt-cf-template", "syncedSha": "a5f887897288acfc4928409d1a2e863e767058c0" },
  "features": { "auth": true, "billing": false, "posthog": null, "opsEvents": true },
  "product": {
    "northStar": "user_activated",
    "activation": { "event": "user_activated", "withinDays": 7 },
    "retention": { "event": "$pageview", "window": "weekly" }
  },
  "secrets": ["NUXT_SESSION_PASSWORD"]
}
